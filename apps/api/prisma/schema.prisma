// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  MEMBER
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String
  password String
}

model Organization {
  id   String @id @default(uuid())
  name String
  slug String
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  organizationId String
  role           MembershipRole
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  description    String
  apikeys        APIKey[]
}

model APIKey {
  id        String    @id @default(uuid())
  projectId String
  name      String
  keyHash   String
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
}
